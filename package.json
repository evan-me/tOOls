{
  "name": "electron-react-sqlite-windows",
  "version": "1.0.1",
  "description": "Electron + React + Vite starter with SQLite (Windows target)",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "dev:renderer": "cd src/renderer && vite",
    "dev:main": "cross-env DEBUG_RENDERER=true electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && npm run dev:main\"",
    "test:main": "node --test \"test/main/*.test.js\"",
    "build:renderer": "cd src/renderer && vite build",
    "build": "npm run build:renderer && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "build:win": "npm run build:renderer && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps",
    "create-icon": "node scripts/create-tray-icon.js",
    "generate-icon": "powershell -ExecutionPolicy Bypass -File scripts/generate-icon.ps1"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "lucide-react": "^1.8.0",
    "marked": "^17.0.6",
    "marked-react": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sql.js": "^1.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^26.0.0",
    "electron-builder": "^26.8.1",
    "vite": "^5.0.0",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.example.electronapp",
    "productName": "tOOls",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      },
      {
        "from": "assets/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "assets/app-icon.png",
        "to": "app-icon.png"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "win": {
      "icon": "assets/app-icon.png",
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/app-icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 120
    }
  },
  "author": "",
  "license": "MIT"
}
